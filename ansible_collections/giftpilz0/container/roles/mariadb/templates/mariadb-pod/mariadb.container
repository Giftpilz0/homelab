[Unit]
Description=MariaDB Container

[Container]
ContainerName=mariadb
Image={{ mariadb_image }}:{{ mariadb_version }}
Pod=mariadb.pod

{% if mariadb_entrypoint %}
Entrypoint={{ mariadb_entrypoint }}
{% endif %}

{% if mariadb_autoupdate %}
AutoUpdate=registry
{% endif %}
{% for env_name, env_value in mariadb_environment_vars.items() %}
Environment={{ env_name }}={{ env_value }}
{% endfor %}

Volume=mariadb-data.volume:/var/lib/mysql
Volume=%h/.config/containers/systemd/mariadb-pod/config/init-databases.sql:/docker-entrypoint-initdb.d/10-databases.sql:ro,Z

{% for volume in quadlet_extra_volumes %}
Volume={{ volume }}
{% endfor %}

[Service]
Restart=always
