[Unit]
Description=Forgejo Container

[Container]
ContainerName=forgejo
Image={{ forgejo_image }}:{{ forgejo_version }}
Pod=forgejo.pod

{% if forgejo_autoupdate %}
AutoUpdate=registry
{% endif %}
{% if forgejo_entrypoint %}
Entrypoint={{ forgejo_entrypoint }}
{% endif %}

{% for env_name, env_value in forgejo_environment_vars.items() %}
Environment={{ env_name }}={{ env_value }}
{% endfor %}

Volume=forgejo-data.volume:/data

{% for volume in quadlet_extra_volumes %}
Volume={{ volume }}
{% endfor %}

[Service]
Restart=always
