[Unit]
Description=Perses

[Container]
ContainerName=perses
Image={{ monitoring_stack_perses_image }}:{{ monitoring_stack_perses_version }}
Pod=monitoring-stack.pod

Exec=--config=/etc/perses/config.yaml

{% if monitoring_stack_perses_autoupdate %}
AutoUpdate=registry
{% endif %}
{% if monitoring_stack_perses_entrypoint %}
Entrypoint={{ monitoring_stack_perses_entrypoint }}
{% endif %}

Volume=perses-data.volume:/var/perses/data
Volume=%h/.config/containers/systemd/monitoring-stack-pod/config/perses.yaml:/etc/perses/config.yaml:Z
Volume=%h/.config/containers/systemd/monitoring-stack-pod/config/provisioning:/etc/perses/provisioning:Z

{% for env_name, env_value in monitoring_stack_perses_environment_vars.items() %}
Environment={{ env_name }}={{ env_value }}
{% endfor %}

{% for volume in quadlet_extra_volumes %}
Volume={{ volume }}
{% endfor %}

[Service]
Restart=always
