[Unit]
Description=Grafana Mimir Metrics Backend
After=garage.service
Requires=garage.service

[Container]
ContainerName=mimir
Image={{ monitoring_stack_mimir_image }}:{{ monitoring_stack_mimir_version }}
Pod=monitoring-stack.pod

Exec=-config.file=/etc/mimir/mimir.yaml

{% if monitoring_stack_mimir_entrypoint %}
Entrypoint={{ monitoring_stack_mimir_entrypoint }}
{% endif %}

{% if monitoring_stack_mimir_autoupdate %}
AutoUpdate=registry
{% endif %}

Volume=mimir-data.volume:/data
Volume=%h/.config/containers/systemd/monitoring-stack-pod/config/mimir.yaml:/etc/mimir/mimir.yaml:Z

{% for env_name, env_value in monitoring_stack_mimir_environment_vars.items() %}
Environment={{ env_name }}={{ env_value }}
{% endfor %}

[Service]
Restart=always
