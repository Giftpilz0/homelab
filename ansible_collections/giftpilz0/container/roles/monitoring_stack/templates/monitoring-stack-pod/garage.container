[Unit]
Description=GarageHQ S3-compatible Object Storage

[Container]
ContainerName=garage
Image={{ monitoring_stack_garage_image }}:{{ monitoring_stack_garage_version }}
Pod=monitoring-stack.pod

{% if monitoring_stack_garage_entrypoint %}
Entrypoint={{ monitoring_stack_garage_entrypoint }}
{% endif %}

{% if monitoring_stack_garage_autoupdate %}
AutoUpdate=registry
{% endif %}

Volume=garage-data.volume:/var/lib/garage/data
Volume=garage-meta.volume:/var/lib/garage/meta
Volume=%h/.config/containers/systemd/monitoring-stack-pod/config/garage.toml:/etc/garage.toml:Z

[Service]
Restart=always
