[Unit]
Description=Authentik Server Container
After=authentik-postgresql.service authentik-cache.service

[Container]
ContainerName=authentik-server
Image=ghcr.io/goauthentik/server:{{ authentik_version }}
Exec=server
{% if authentik_entrypoint %}
Entrypoint={{ authentik_entrypoint }}
{% endif %}

Pod=authentik.pod

{% if authentik_server_autoupdate %}
AutoUpdate=registry
{% endif %}

{% if authentik_server_environment_vars is defined %}
{% for env_name, env_value in authentik_server_environment_vars.items() %}
Environment={{ env_name }}={{ env_value }}
{% endfor %}
{% endif %}

{% if authentik_proxy_enabled %}
{% for env_var in authentik_proxy_env %}
Environment={{ env_var }}
{% endfor %}
{% endif %}

Volume=authentik-media.volume:/media
Volume=authentik-templates.volume:/templates
Volume=authentik-certs.volume:/certs

{% for item in (authentik_extra_files | default([]) + authentik_extra_dirs | default([])) if item.mount is defined and item.mount %}
Volume={{ item.source | default('%h/.config/containers/systemd/authentik-pod/' ~ item.dest) }}:{{ item.mount }}:Z
{% endfor %}
[Service]
Restart=always
