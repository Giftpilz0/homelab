[Unit]
Description=Market Watch Database Stats (manual)

[Container]
ContainerName=market-watch-db-stats
Image={{ market_watch_image }}:{{ market_watch_version }}
Exec=db-stats

Environment=DB_PATH={{ market_watch_db_path }}
{% for env_name, env_value in market_watch_environment_vars.items() %}
Environment={{ env_name }}={{ env_value }}
{% endfor %}

# Reads only; the database is opened read-write because WAL needs its -shm file
Volume=market-watch-data.volume:/data
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL

# No timer: systemctl --user start market-watch-db-stats, then journalctl --user -u market-watch-db-stats
[Service]
Type=oneshot
RuntimeMaxSec=5min
CPUWeight=20
