[Unit]
Description=Market Watch Fundamentals

[Container]
ContainerName=market-watch-scan-fundamentals
Image={{ market_watch_image }}:{{ market_watch_version }}
Exec=scan-fundamentals

Environment=DATA_REPO={{ market_watch_data_repo }}
Environment=DEPLOY_KEY={{ market_watch_deploy_key | trim | b64encode }}
Environment=DB_PATH={{ market_watch_db_path }}
{% for env_name, env_value in market_watch_environment_vars.items() %}
Environment={{ env_name }}={{ env_value }}
{% endfor %}

# Writes only its run record into the database on the data volume
Volume=market-watch-data.volume:/data
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL

# Started by market-watch-scan-fundamentals.timer
[Service]
Type=oneshot
# The job stops starting requests when its time budget is spent and publishes what it has
RuntimeMaxSec={{ market_watch_scan_fundamentals_timeout }}
CPUWeight=20
