[Unit]
Description=Market Watch Nightly Scan

[Container]
ContainerName=market-watch-scan-eod
Image={{ market_watch_image }}:{{ market_watch_version }}
Exec=scan-eod

Environment=DATA_REPO={{ market_watch_data_repo }}
Environment=DEPLOY_KEY={{ market_watch_deploy_key | trim | b64encode }}
Environment=DB_PATH={{ market_watch_db_path }}
{% for env_name, env_value in market_watch_environment_vars.items() %}
Environment={{ env_name }}={{ env_value }}
{% endfor %}

# Writes the fetched daily bars into the database
Volume=market-watch-data.volume:/data
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL

# Started by market-watch-scan-eod.timer
[Service]
Type=oneshot
# The job stops starting requests after 30 minutes and then publishes what it has
RuntimeMaxSec={{ market_watch_scan_eod_timeout }}
CPUWeight=20
