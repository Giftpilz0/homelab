{% if opencloud_radicale_enabled %}
[Unit]
Description=Radicale CalDAV/CardDAV for OpenCloud

[Container]
ContainerName=radicale
Image={{ opencloud_radicale_image }}:{{ opencloud_radicale_version }}
Pod=radicale.pod
User=1000
Group=1000

{% if opencloud_radicale_entrypoint %}
Entrypoint={{ opencloud_radicale_entrypoint }}
{% endif %}

{% if opencloud_autoupdate %}
AutoUpdate=registry
{% endif %}

Volume=radicale-data.volume:/var/lib/radicale
Volume=%h/.config/containers/systemd/opencloud-additional/config/radicale.conf:/etc/radicale/config:ro,Z
HealthCmd=["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:5232/.web/"]
HealthInterval=30s
HealthStartPeriod=10s
HealthOnFailure=kill

[Service]
Restart=always
{% endif %}
