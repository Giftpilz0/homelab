[Unit]
Description=ACME DNS Container

[Container]
ContainerName=acme_dns
Image={{ acme_dns_image }}:{{ acme_dns_version }}
Pod=acme_dns.pod

{% if acme_dns_autoupdate %}
AutoUpdate=registry
{% endif %}
{% if acme_dns_entrypoint %}
Entrypoint={{ acme_dns_entrypoint }}
{% endif %}

{% for env_name, env_value in acme_dns_environment_vars.items() %}
Environment={{ env_name }}={{ env_value }}
{% endfor %}

Volume=acme_dns-data.volume:/var/lib/acme-dns
Volume=%h/.config/containers/systemd/acme_dns-pod/config/config.cfg:/etc/acme-dns/config.cfg:ro,Z

{% for volume in quadlet_extra_volumes %}
Volume={{ volume }}
{% endfor %}

[Service]
Restart=always