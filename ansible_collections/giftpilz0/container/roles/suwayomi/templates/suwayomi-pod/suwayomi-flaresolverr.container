[Unit]
Description=Suwayomi FlareSolverr Container

[Container]
ContainerName=flaresolverr
Image={{ suwayomi_flaresolverr_image }}:{{ suwayomi_flaresolverr_version }}
Pod=suwayomi.pod

{% if suwayomi_flaresolverr_autoupdate %}
AutoUpdate=registry
{% endif %}
{% if suwayomi_flaresolverr_entrypoint %}
Entrypoint={{ suwayomi_flaresolverr_entrypoint }}
{% endif %}

{% for env_name, env_value in suwayomi_flaresolverr_environment_vars.items() %}
Environment={{ env_name }}={{ env_value }}
{% endfor %}

[Service]
Restart=always
