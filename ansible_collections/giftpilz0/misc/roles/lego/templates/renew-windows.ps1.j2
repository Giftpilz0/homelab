param(
  [switch]$RunHook,
  [string]$CertificateName
)

$ErrorActionPreference = 'Stop'
$Lego = '{{ lego_path }}\lego.exe'
$State = '{{ lego_state_path }}'
$Server = '{{ lego_acme_server }}'
$ServerHost = ([Uri]$Server).Host -replace ':', '_'
$EventSource = '{{ lego_windows_event_source }}'

# Console and Application event log; messages are capped below its 32k limit.
# A failing event log never stops the renewal.
function Write-Log([string]$Message, [string]$EntryType = 'Information', [int]$EventId = 1000) {
  Write-Host $Message
  if ($EventSource) {
    $Text = if ($Message.Length -gt 30000) { $Message.Substring(0, 30000) + ' [truncated]' } else { $Message }
    try {
      Write-EventLog -LogName Application -Source $EventSource -EntryType $EntryType -EventId $EventId -Message $Text
    }
    catch {
      Write-Warning "Cannot write to the event log: $_"
    }
  }
}

try {
  Write-Log "Started Lego processing; hook-only mode: $RunHook"
  if ($RunHook -and -not $CertificateName) {
    throw 'RunHook requires -CertificateName so only the requested deployment hook is executed'
  }

{% for item in _lego_certificates %}
if (-not $CertificateName -or $CertificateName -eq '{{ item.name }}') {
Write-Log 'Processing {{ item.name }}'
$Environment = Join-Path $State '{{ item.name }}.ps1'
if (Test-Path -LiteralPath $Environment) {
  . $Environment
}

$Certificate = Join-Path $State 'certificates\{{ item.domains[0] | replace('*', '_') }}.crt'
if ($RunHook) {
  $Arguments = @()
  $ExitCode = 0
}
else {
$Arguments = @(
  'run'
  '--accept-tos'
  '--email', '{{ lego_acme_email }}',
  '--server', $Server,
  '--path', $State,
  '--key-type', '{{ item.key_type }}'
{% if item.challenge.type == 'dns-01' %}
  '--dns', '{{ item.challenge.provider }}'
{% elif item.challenge.type == 'http-01' %}
  '--http'
{% else %}
  '--tls-alpn'
{% endif %}
{% for domain in item.domains %}
  '--domains', '{{ domain }}'
{% endfor %}
{% for resolver in lego_acme_dns_resolvers %}
  '--dns.resolvers', '{{ resolver }}'
{% endfor %}
{% for argument in lego_extra_args %}
  '{{ argument }}'
{% endfor %}
{% for argument in item.extra_args %}
  '{{ argument }}'
{% endfor %}
  '--pem'
{% if item.deploy.pfx is defined %}
  '--pfx'
{% endif %}
)
if (Test-Path -LiteralPath $Certificate) {
  $Arguments += @('--renew-days', '{{ item.renewal.threshold }}')
}

Write-Log "Running: $Lego $($Arguments -join ' ')"
$AccountId = '{{ item.account_id }}'
$AccountDir = Join-Path $State "accounts\$ServerHost\$AccountId"
$Output = (& $Lego @Arguments 2>&1 | Out-String)
$ExitCode = $LASTEXITCODE
Write-Log "Lego output for {{ item.name }} (exit code $ExitCode):`n$Output" -EventId 1001

if (($ExitCode -ne 0) -and ($Output -match 'accountDoesNotExist')) {
  if (-not (Test-Path -LiteralPath $AccountDir -PathType Container)) {
    throw "Lego failed for {{ item.name }}: stale account directory was not found"
  }

  $StaleAccountDir = "$AccountDir.stale.$(Get-Date -Format yyyyMMdd_HHmmss)"
  Write-Log "Archiving stale Lego account: $AccountDir" -EntryType Warning
  Move-Item -LiteralPath $AccountDir -Destination $StaleAccountDir
  $Output = (& $Lego @Arguments 2>&1 | Out-String)
  $ExitCode = $LASTEXITCODE
  Write-Log "Lego output for {{ item.name }} (exit code $ExitCode):`n$Output" -EventId 1001
}

if ($ExitCode -ne 0) {
  throw "Lego failed for {{ item.name }} with exit code $ExitCode"
}
}

$Marker = Join-Path $State '.{{ item.name }}.deployed'
$Changed = $RunHook -or (-not (Test-Path -LiteralPath $Marker) -or
  ((Get-Item -LiteralPath $Certificate).LastWriteTime -gt (Get-Item -LiteralPath $Marker).LastWriteTime)
)
if ($Changed) {
  Write-Log 'Deploying {{ item.name }}' -EventId 1002
{% if item.deploy.pfx is defined %}
  $PfxSource = Join-Path $State 'certificates\{{ item.domains[0] | replace('*', '_') }}.pfx'
  $PfxDestination = '{{ item.deploy.pfx.path }}'
  if (-not [String]::Equals($PfxSource, $PfxDestination, [StringComparison]::OrdinalIgnoreCase)) {
    Copy-Item -LiteralPath $PfxSource -Destination $PfxDestination -Force
  }
{% if item.deploy.windows_store is defined %}
{% set store = lego_deploy_windows_store_defaults | combine(item.deploy.windows_store) %}
  $PfxPassword = ConvertTo-SecureString $env:LEGO_PFX_PASSWORD -AsPlainText -Force
  Import-PfxCertificate -FilePath '{{ item.deploy.pfx.path }}' -CertStoreLocation 'Cert:\{{ store.store_location }}\{{ store.store_name }}' -Password $PfxPassword | Out-Null
{% endif %}
{% endif %}
{% for hook in item.hooks.changed | selectattr('script', 'defined') %}
  {{ hook.script }}
{% endfor %}
  if (-not $RunHook) {
    New-Item -ItemType File -Path $Marker -Force | Out-Null
  }
  Write-Log 'Deployed {{ item.name }}' -EventId 1002
}
}
{% endfor %}
  Write-Log 'Completed Lego processing'
}
catch {
  Write-Log "Lego processing failed: $_`n$($_.ScriptStackTrace)" -EntryType Error -EventId 1100
  exit 1
}
