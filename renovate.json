{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    ":timezone(Europe/Berlin)",
    "schedule:weekly"
  ],
  "pre-commit": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions annotated with '# renovate: datasource=... depName=...' on the line above",
      "managerFilePatterns": [
        "/.+\\.ya?ml$/",
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)(?:\\s+registryUrl=(?<registryUrl>[^\\s]+))?(?:\\s+extractVersion=(?<extractVersion>[^\\s]+))?(?:\\s+versioning=(?<versioning>[^\\s]+))?\\n(?:[\\w_]+:\\s*|ARG \\w+=)[\"']?(?<currentValue>[^\\s\"'\\n#]+)[\"']?"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Hub image and agent binary must stay on the same version",
      "matchPackageNames": ["henrygd/beszel"],
      "groupName": "beszel"
    },
    {
      "description": "Database majors need a dump and restore",
      "matchPackageNames": ["postgres", "mariadb"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
